# Environment and secrets - NEVER commit
.env
.env-ai
.env.*
!.env.example

# Install artifacts (per-machine answers, not shared)
.install-answers

# Vault local state (per-machine, not shared)
vault-skeleton/.local-state/
.local-state/

# Member-local override files (per-member customizations, stay local)
*.local.md
CLAUDE.local.md
ETHOS.local.md

# Backup files created during updates
*.bak-*
*.bak

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor
.vscode/settings.json
.idea/

# Node (if any tooling added)
node_modules/
npm-debug.log*

# Python cache (scripts may use python3)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# IMPORTANT: vault-skeleton/.obsidian/plugins/ must NOT be gitignored.
# Plugin code ships with this package. Only ignore generated/binary data:
vault-skeleton/_attachments/
vault-skeleton/.obsidian/workspace.json
vault-skeleton/.obsidian/workspace-mobile.json

# Temporary files
*.tmp
*.swp
*~

# Maintainer-local PII denylist (org/person specific - never publish)
.sanitize-denylist
