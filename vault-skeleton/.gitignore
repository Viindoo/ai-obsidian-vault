# Obsidian workspace state (user-local, not shared)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/data-*.json

# Binary attachments (large files, not versioned)
_attachments/*
!_attachments/.gitkeep

# Member-local override files (instance-specific config, never commit)
*.local.md
.env-ai

# Backup files
*.bak-*

# Install state (machine-specific)
.install-answers

# Local state folder (sentinel files, auto-generated)
.local-state/

# AI-Memory digest (auto-generated by gen-memory-digest.sh, do not commit)
# _digest.md is ignored (member regenerates via gen-memory-digest.sh on install).
Engineering/AI-Memory/_digest.md

# Obsidian community plugin CODE (tai tu nguon chinh thuc qua install-obsidian-plugins.sh,
# KHONG bundle/commit). Chi data.json (config cua ta) duoc track.
.obsidian/plugins/*/main.js
.obsidian/plugins/*/manifest.json
.obsidian/plugins/*/styles.css
