{
  "choices": [
    {
      "id": "qa-daily",
      "name": "📅 Daily Note (today)",
      "type": "Capture",
      "command": false,
      "captureTo": "Daily/{{DATE:YYYY}}/{{DATE:MM}}/{{DATE:YYYY-MM-DD}}.md",
      "captureToActiveFile": false,
      "createFileIfItDoesntExist": {
        "enabled": true,
        "createWithTemplate": true,
        "template": "Templates/Daily Note.md"
      },
      "format": {
        "enabled": true,
        "format": "{{VALUE}}\n"
      },
      "openFile": true,
      "openFileInNewTab": {
        "enabled": false,
        "direction": "vertical",
        "focus": true,
        "mode": "default"
      },
      "fileOpening": {
        "location": "tab",
        "direction": "vertical",
        "focus": true,
        "mode": "default"
      }
    },
    {
      "id": "qa-inbox",
      "name": "📥 Inbox capture",
      "type": "Capture",
      "command": true,
      "captureTo": "Inbox/{{DATE:YYYY-MM-DD-HHmmss}}.md",
      "captureToActiveFile": false,
      "createFileIfItDoesntExist": {
        "enabled": true,
        "createWithTemplate": false,
        "template": ""
      },
      "format": {
        "enabled": true,
        "format": "---\nid: inbox-{{DATE:YYYY-MM-DD-HHmmss}}\ntype: inbox\ncreated: {{DATE:YYYY-MM-DD}}\nupdated: {{DATE:YYYY-MM-DD}}\ntags: [lifecycle/draft]\nsummary: \nstatus: draft\n---\n\n{{VALUE}}\n"
      },
      "openFile": false,
      "fileOpening": {
        "location": "tab",
        "direction": "vertical",
        "mode": "default",
        "focus": true
      }
    },
    {
      "id": "qa-meeting",
      "name": "📝 Meeting note (prompt topic)",
      "type": "Template",
      "command": true,
      "templatePath": "Templates/Meeting Note.md",
      "fileNameFormat": {
        "enabled": true,
        "format": "{{VALUE:topic}}_{{DATE:YYYY-MM-DD}}"
      },
      "folder": {
        "enabled": true,
        "folder": [
          "Operations/Meetings"
        ],
        "chooseWhenCreatingNote": false,
        "createInSameFolderAsActiveFile": false,
        "chooseFromSubfolders": false
      },
      "openFile": true,
      "fileOpening": {
        "location": "tab",
        "direction": "vertical",
        "mode": "default",
        "focus": true
      }
    },
    {
      "id": "qa-brief",
      "name": "📊 Strategy brief (1-pager)",
      "type": "Template",
      "command": true,
      "templatePath": "Templates/Brief 1-Pager.md",
      "fileNameFormat": {
        "enabled": true,
        "format": "brief-{{VALUE:topic}}_{{DATE:YYYY-MM-DD}}"
      },
      "folder": {
        "enabled": true,
        "folder": [
          "Strategy/Briefs"
        ]
      },
      "openFile": true,
      "fileOpening": {
        "location": "tab",
        "direction": "vertical",
        "mode": "default",
        "focus": true
      }
    },
    {
      "id": "qa-competitor",
      "name": "🎯 Competitor watch",
      "type": "Template",
      "command": true,
      "templatePath": "Templates/Competitor Watch.md",
      "fileNameFormat": {
        "enabled": true,
        "format": "{{VALUE:vendor}}_{{DATE:YYYY-MM-DD}}"
      },
      "folder": {
        "enabled": true,
        "folder": [
          "Resources/Competitors"
        ]
      },
      "openFile": true,
      "fileOpening": {
        "location": "tab",
        "direction": "vertical",
        "mode": "default",
        "focus": true
      }
    },
    {
      "id": "qa-deal",
      "name": "💼 Deal log",
      "type": "Template",
      "command": true,
      "templatePath": "Templates/Deal Log.md",
      "fileNameFormat": {
        "enabled": true,
        "format": "{{VALUE:deal}}_{{DATE:YYYY-MM-DD}}"
      },
      "folder": {
        "enabled": true,
        "folder": [
          "Sales/Pipeline"
        ]
      },
      "openFile": true,
      "fileOpening": {
        "location": "tab",
        "direction": "vertical",
        "mode": "default",
        "focus": true
      }
    },
    {
      "id": "qa-customer",
      "name": "🏢 Customer profile",
      "type": "Template",
      "command": true,
      "templatePath": "Templates/Customer Profile.md",
      "fileNameFormat": {
        "enabled": true,
        "format": "{{VALUE:customer}}"
      },
      "folder": {
        "enabled": true,
        "folder": [
          "Sales/Customers"
        ]
      },
      "openFile": true,
      "fileOpening": {
        "location": "tab",
        "direction": "vertical",
        "mode": "default",
        "focus": true
      }
    },
    {
      "id": "qa-decision",
      "name": "⚡ Decision record",
      "type": "Template",
      "command": true,
      "templatePath": "Templates/Decision Record.md",
      "fileNameFormat": {
        "enabled": true,
        "format": "decision-{{VALUE:topic}}_{{DATE:YYYY-MM-DD}}"
      },
      "folder": {
        "enabled": true,
        "folder": [
          "Strategy/Decisions"
        ]
      },
      "openFile": true,
      "fileOpening": {
        "location": "tab",
        "direction": "vertical",
        "mode": "default",
        "focus": true
      }
    }
  ],
  "inputPrompt": "single-line",
  "persistInputPromptDrafts": true,
  "useSelectionAsCaptureValue": true,
  "devMode": false,
  "templateFolderPath": "",
  "announceUpdates": "major",
  "version": "2.12.0",
  "globalVariables": {},
  "onePageInputEnabled": false,
  "disableOnlineFeatures": true,
  "enableRibbonIcon": false,
  "showCaptureNotification": true,
  "showInputCancellationNotification": false,
  "enableTemplatePropertyTypes": false,
  "dateAliases": {
    "t": "today",
    "tm": "tomorrow",
    "yd": "yesterday",
    "nw": "next week",
    "nm": "next month",
    "ny": "next year",
    "lw": "last week",
    "lm": "last month",
    "ly": "last year"
  },
  "ai": {
    "defaultModel": "Disabled",
    "defaultSystemPrompt": "",
    "promptTemplatesFolderPath": "",
    "showAssistant": false,
    "providers": [
      {
        "name": "OpenAI",
        "endpoint": "https://api.openai.com/v1",
        "apiKey": "",
        "models": [
          {
            "name": "gpt-3.5-turbo",
            "maxTokens": 4096
          },
          {
            "name": "gpt-3.5-turbo-16k",
            "maxTokens": 16384
          },
          {
            "name": "gpt-3.5-turbo-1106",
            "maxTokens": 16385
          },
          {
            "name": "gpt-4",
            "maxTokens": 8192
          },
          {
            "name": "gpt-4-32k",
            "maxTokens": 32768
          },
          {
            "name": "gpt-4-1106-preview",
            "maxTokens": 128000
          },
          {
            "name": "gpt-4-turbo",
            "maxTokens": 128000
          },
          {
            "name": "gpt-4o",
            "maxTokens": 128000
          },
          {
            "name": "gpt-4o-mini",
            "maxTokens": 128000
          }
        ],
        "autoSyncModels": false,
        "modelSource": "modelsDev"
      },
      {
        "name": "Gemini",
        "endpoint": "https://generativelanguage.googleapis.com",
        "apiKey": "",
        "models": [
          {
            "name": "gemini-1.5-pro",
            "maxTokens": 1000000
          },
          {
            "name": "gemini-1.5-flash",
            "maxTokens": 1000000
          },
          {
            "name": "gemini-1.5-flash-8b",
            "maxTokens": 1000000
          }
        ],
        "autoSyncModels": false,
        "modelSource": "modelsDev"
      }
    ]
  },
  "migrations": {
    "migrateToMacroIDFromEmbeddedMacro": true,
    "useQuickAddTemplateFolder": true,
    "incrementFileNameSettingMoveToDefaultBehavior": true,
    "mutualExclusionInsertAfterAndWriteToBottomOfFile": false,
    "setVersionAfterUpdateModalRelease": true,
    "addDefaultAIProviders": true,
    "removeMacroIndirection": true,
    "migrateFileOpeningSettings": true,
    "backfillFileOpeningDefaults": true,
    "setProviderModelDiscoveryMode": true,
    "migrateProviderApiKeysToSecretStorage": true
  },
  "embedSettings": {
    "defaultEmbedType": "Markdown"
  }
}