{
  "edge_field_groups": [
    {
      "label": "Hierarchy",
      "fields": [
        "up",
        "down",
        "next",
        "prev"
      ]
    }
  ],
  "explicit_edge_sources": {
    "list_note": {
      "default_neighbour_field": null
    },
    "tag_note": {
      "default_field": "up",
      "default_sibling_field": ""
    },
    "regex_note": {
      "default_field": "up"
    },
    "dendron_note": {
      "enabled": false,
      "delimiter": ".",
      "default_field": "up",
      "default_sibling_field": "",
      "display_trimmed": false
    },
    "date_note": {
      "enabled": true,
      "default_field": "next",
      "date_format": "yyyy-MM-dd",
      "stretch_to_existing": true,
      "week": {
        "enabled": false,
        "date_format": "kkkk-'W'WW",
        "folder": "",
        "next_field": "next",
        "up_field": "up"
      },
      "month": {
        "enabled": false,
        "date_format": "yyyy-MM",
        "folder": "",
        "next_field": "next",
        "up_field": "up"
      },
      "quarter": {
        "enabled": false,
        "date_format": "yyyy-'Q'q",
        "folder": "",
        "next_field": "next",
        "up_field": "up"
      },
      "year": {
        "enabled": false,
        "date_format": "yyyy",
        "folder": "",
        "next_field": "next",
        "up_field": "up"
      }
    },
    "typed_link": {},
    "johnny_decimal_note": {
      "enabled": false,
      "delimiter": ".",
      "default_field": "up",
      "default_sibling_field": ""
    }
  },
  "implied_relations": {
    "transitive": []
  },
  "views": {
    "page": {
      "all": {
        "sticky": false,
        "readable_line_width": true
      },
      "trail": {
        "enabled": true,
        "default_depth": 999,
        "format": "grid",
        "show_node_options": {
          "ext": false,
          "folder": false,
          "alias": true
        },
        "show_controls": true,
        "no_path_message": "",
        "selection": "all",
        "merge_fields": false,
        "field_group_labels": [
          "ups"
        ]
      },
      "prev_next": {
        "enabled": true,
        "show_node_options": {
          "ext": false,
          "folder": false,
          "alias": false
        },
        "field_group_labels": {
          "prev": [
            "prevs"
          ],
          "next": [
            "nexts"
          ]
        },
        "period_rows": {
          "week": false,
          "month": false,
          "quarter": false,
          "year": false
        }
      }
    },
    "side": {
      "matrix": {
        "collapse": false,
        "edge_sort_id": {
          "field": "basename",
          "order": 1
        },
        "custom_sort_fields": false,
        "custom_sort_field_labels": [],
        "show_node_options": {
          "ext": false,
          "folder": false,
          "alias": false
        },
        "show_attributes": [
          "source",
          "implied_kind",
          "round"
        ],
        "field_group_labels": [
          "ups",
          "downs",
          "sames",
          "nexts",
          "prevs"
        ],
        "lock_view": false,
        "lock_path": ""
      },
      "tree": {
        "collapse": false,
        "show_attributes": [],
        "merge_fields": false,
        "default_depth": 5,
        "lock_view": false,
        "lock_path": "",
        "field_group_labels": [
          "ups",
          "downs"
        ],
        "edge_sort_id": {
          "field": "basename",
          "order": 1
        },
        "show_node_options": {
          "ext": false,
          "folder": false,
          "alias": false
        },
        "find_root": true,
        "find_root_field_group_labels": [
          "ups"
        ]
      }
    },
    "codeblocks": {
      "show_node_options": {
        "ext": false,
        "folder": false,
        "alias": false
      }
    }
  },
  "commands": {
    "rebuild_graph": {
      "notify": false,
      "trigger": {
        "note_save": false,
        "layout_change": false
      }
    },
    "list_index": {
      "default_options": {
        "fields": [],
        "indent": "\\t",
        "link_kind": "wiki",
        "show_attributes": [],
        "field_group_labels": [],
        "edge_sort_id": {
          "order": 1,
          "field": "basename"
        },
        "show_node_options": {
          "ext": false,
          "alias": true,
          "folder": false
        }
      }
    },
    "freeze_implied_edges": {
      "default_options": {
        "destination": "frontmatter",
        "included_fields": [],
        "use_alias": true
      }
    },
    "thread": {
      "default_options": {
        "destination": "frontmatter",
        "target_path_template": "{{source.folder}}/{{attr.field}} {{source.basename}}"
      }
    }
  },
  "suggestors": {
    "edge_field": {
      "enabled": true,
      "trigger": "."
    }
  },
  "debug": {
    "level": "WARN"
  },
  "is_dirty": false,
  "edge_fields": [
    {
      "label": "up"
    },
    {
      "label": "down"
    },
    {
      "label": "same"
    },
    {
      "label": "next"
    },
    {
      "label": "prev"
    }
  ],
  "_bc_migrations": {
    "tree_ups_with_downs_default": true,
    "tree_find_root_default": true
  }
}